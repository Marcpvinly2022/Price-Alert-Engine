# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values. NEVER commit the real .env.
# This file documents every variable the app reads and why it exists.
# ─────────────────────────────────────────────────────────────────────────────

# HTTP port for the Express API.
PORT=3000

# --- Postgres (source of truth / audit log) ----------------------------------
# Supabase transaction pooler connection string. `disconnect()` in
# src/config/database.js closes this pool cleanly on shutdown.
DATABASE_URL="postgresql://<user>:<password>@<host>:6543/postgres?connect_timeout=10&pgbouncer=true"
DIRECT_URL="postgresql://<user>:<password>@<host>:5432/postgres?connect_timeout=10"

# --- Supabase (auth) ---------------------------------------------------------
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_PUBLISHABLE_KEY="<publishable-key>"
SUPABASE_SECRET_KEY="<secret-key>"
SUPABASE_JWKS_URI="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"

# --- Email delivery (SMTP via nodemailer) ------------------------------------
# Works with ANY SMTP provider — Gmail, Brevo, SendGrid, Mailtrap, etc. No domain
# required (Gmail sends to any recipient with an App Password). Switching
# providers is a pure .env change; no code change.
#   Gmail: turn on 2-Step Verification, then create an App Password (16 chars)
#   and put it in SMTP_PASSWORD — NOT your normal Google password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false          # false = STARTTLS (port 587); true = implicit TLS (port 465)
SMTP_USER=you@gmail.com
SMTP_PASSWORD=<gmail-app-password>
MAIL_FROM="Price Alert Engine <you@gmail.com>"
# Optional, DEV ONLY. Set to false if an antivirus/proxy intercepts the SMTP TLS
# handshake ("self-signed certificate in certificate chain"). Skips cert-chain
# validation for SMTP only. Leave unset (strict) in production.
# SMTP_TLS_REJECT_UNAUTHORIZED=false

# --- FX rate provider (ExchangeRate-API) -------------------------------------
# Free API key from https://www.exchangerate-api.com (sign up → dashboard).
# The key is used as a PATH segment by src/providers/fx.provider.js:
#   https://v6.exchangerate-api.com/v6/<KEY>/latest/USD
# If this is unset the provider throws immediately; if it's wrong the live fetch
# fails and the circuit breaker falls back to the SIMULATE_PROVIDER.
EXCHANGERATE_API_KEY=<your-exchangerate-api-key>

# --- Redis (BullMQ transport) ------------------------------------------------
# Redis runs on the Ubuntu VM inside VMware; the Node app runs on Windows. So
# this MUST be the VM's IP (from `hostname -I` on Ubuntu), NOT 127.0.0.1. Add
# credentials as redis://:<password>@<VM_IP>:6379 if you set `requirepass`.
REDIS_URL=redis://<VM_IP>:6379

# --- BullMQ delivery worker & reconciler -------------------------------------
# true  = run the worker inside the API process (single `npm run dev` runs all).
# false = run `npm run worker` as separate process(es) for horizontal scale.
RUN_WORKER_IN_PROCESS=true
# Jobs delivered concurrently by ONE worker process.
NOTIFICATION_WORKER_CONCURRENCY=10
# Global send-rate ceiling per worker (jobs/sec) to respect your SMTP provider's
# limits (free Gmail is ~500 emails/day).
NOTIFICATION_RATE_LIMIT_PER_SEC=20
# Reconciler sweep interval, and how old a PENDING row must be to count as an
# orphan that needs re-enqueuing.
RECONCILER_INTERVAL_MS=30000
RECONCILER_GRACE_MS=30000
# Optional: max orphans re-enqueued per reconciler tick (defaults to 1000).
# RECONCILER_BATCH_SIZE=1000

# Optional: price-check cadence in ms (defaults to 60000).
# PRICE_CHECK_INTERVAL_MS=60000
